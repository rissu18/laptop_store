# Kopeeri see fail nimega .env.local (arendus) või .env (server) ja täida väärtused.
# .env faile EI commit'ita kunagi Git'i.

# Poe avalik aadress (kasutatakse canonical URL-ides, sitemap'is, structured data's)
SITE_URL=http://localhost:3000

# Prototüübirežiim: näitab testandmete hoiatust ja kinnitamata väiteid, keelab indekseerimise.
# Pane "false" alles siis, kui pood on päriselt avamiseks valmis.
PROTOTYPE_MODE=true

# --- Icecat (tootepildid) ---
# Open Icecati kasutajanimi (pole saladus). Tokenid on valikulised: Open Icecat töötab ka ilma.
# Tokenid saadetakse AINULT HTTP päistes, mitte URL-is. Päris väärtused ainult .env.local / Verceli seadetesse.
ICECAT_USERNAME=
ICECAT_API_TOKEN=
ICECAT_CONTENT_TOKEN=

# --- Lisanduvad järgmistes etappides ---
# Phase 2: DATABASE_URL=postgresql://user:password@localhost:5432/sulearvutipood
# Phase 3: SESSION_SECRET=
# Phase 4: SUPPLIER_*_API_URL= / SUPPLIER_*_API_KEY=      (TODO: REAL PROVIDER DATA REQUIRED)
# Phase 6: PAYMENT_*=                                    (TODO: REAL PROVIDER DATA REQUIRED)
# Phase 7: SMTP_HOST= / SMTP_PORT= / SMTP_USER= / SMTP_PASSWORD= / EMAIL_FROM=
