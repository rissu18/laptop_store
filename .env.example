# Kopeeri see fail nimega .env.local (arendus) või .env (server) ja täida väärtused.
# .env faile EI commit'ita kunagi Git'i.

# Poe avalik aadress (kasutatakse canonical URL-ides, sitemap'is, structured data's)
SITE_URL=http://localhost:3000

# Prototüübirežiim (hoiatusriba + noindex) on nüüd poe seadetes: admin → Seaded → Pood.

# --- PostgreSQL ---
# Lokaalselt: `npx vercel env pull .env.development.local` (Neon). Väärtusi EI commit'ita ega kuvata.
# Rakendus loeb DATABASE_URL (või Vercel+Neon nimega database_DATABASE_URL); migratsioonid UNPOOLED ühendust.
# Ilma andmebaasita kasutab pood mock-andmeid (admin vajab andmebaasi).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Admin ---
# Kasutaja luuakse käsuga `npm run admin:create` (parool küsitakse varjatult). Vaikeparooli pole.
# Mitteinteraktiivselt võib anda ADMIN_EMAIL / ADMIN_NAME / ADMIN_PASSWORD ainult käsu käivitamise ajaks.

# --- Icecat (tootepildid) ---
# Open Icecati kasutajanimi (pole saladus). Tokenid on valikulised: Open Icecat töötab ka ilma.
# Tokenid saadetakse AINULT HTTP päistes, mitte URL-is. Päris väärtused ainult .env.local / Verceli seadetesse.
ICECAT_USERNAME=
ICECAT_API_TOKEN=
ICECAT_CONTENT_TOKEN=

# --- Laptopid.ee kataloog (vt docs/LAPTOPID_SYNC.md) ---
# API võti: AINULT server, saadetakse ainult päises X-API-Key. Päris väärtus Verceli seadetesse / .env.development.local.
LAPTOPID_API_KEY=
# products.php ja images.php kataloog (Config, mitte saladus). Klient ehitab: new URL("products.php", base).
LAPTOPID_API_BASE_URL=https://laptopid.ee/api/sulearvutid/
# --- Tech hinnakiri (vt docs/TECH_SYNC.md) ---
# Avalik Google Sheet (Config, mitte saladus). XLSX ekspordi URL ehitatakse sellest (CSV-d ei kasutata — värvid kaoks).
TECH_SHEET_URL=

# --- Foxway API (vt docs/FOXWAY_SYNC.md) ---
# FOXWAY_API_KEY on SALADUS (päis X-ApiKey) — ainult .env.local / Vercel Sensitive, mitte kunagi Git'i.
FOXWAY_API_BASE_URL=https://foxway.shop
FOXWAY_API_KEY=

# Ajastatud sync'i otspunktide (/api/cron/laptopid-sync, /api/cron/tech-sync, /api/cron/foxway-sync) kaitse — Vercel Cron saadab "Authorization: Bearer <CRON_SECRET>".
# Vähemalt 16 juhuslikku märki. Puudumisel otspunkt ei käivitu (sync ainult admin → Tarnijad → Sync now).
CRON_SECRET=

# --- Lisanduvad järgmistes etappides ---
# Phase 4: SUPPLIER_*_API_URL= / SUPPLIER_*_API_KEY=      (TODO: REAL PROVIDER DATA REQUIRED)
# Phase 6: PAYMENT_*=                                    (TODO: REAL PROVIDER DATA REQUIRED)
# Phase 7: SMTP_HOST= / SMTP_PORT= / SMTP_USER= / SMTP_PASSWORD= / EMAIL_FROM=
