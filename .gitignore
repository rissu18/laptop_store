# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — saladusi ei commit'ita kunagi; näidis on .env.example
.env
.env.local
.env.*.local
.env*
!.env.example

# muud saladusi sisaldavad failid (võtmed, sertifikaadid, teenusekontod)
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
/secrets/
credentials*.json
service-account*.json

# andmebaasi dump'id ja varukoopiad (võivad sisaldada kliendiandmeid)
*.sql
*.dump
*.sql.gz
/backups/

# Tootepildid (public/media/products) ja nende kirjed (data/media/product-images.json)
# on TESTVERSIOONI jaoks ajutiselt Git'is, et Vercel saaks neid serveerida.
# Tootmises asenduvad need püsiva salvestusruumiga (S3-ühilduv, vt docs/PROJECT_PLAN.md R13).
/data/media/*.tmp
/public/media/**/*.tmp

# testide väljund
/playwright-report/
/test-results/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
